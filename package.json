{
  "name": "edumfa-push",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "postinstall": "bun run licenses:generate",
    "prestart": "bun run licenses:generate",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas-build-on-complete": "sentry-eas-build-on-complete",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "i18n:check": "bun run i18n:extract && bun run i18n:compile && git diff --exit-code -- src/locales",
    "licenses:check": "bun run licenses:generate && git diff --exit-code -- src/generated/open-source-licenses.ts",
    "licenses:generate": "bun scripts/generate-open-source-licenses.mjs",
    "test": "jest",
    "lint": "expo lint",
    "clean-ios": "watchman watch-del-all && rm -fr $TMPDIR/haste-map-* && rm -rf $TMPDIR/metro-cache && bunx expo prebuild --clean && bunx expo run:ios --device --no-build-cache",
    "full-clean-ios": "rm -rf node_modules && bun pm cache rm && bun i && watchman watch-del-all && rm -fr $TMPDIR/haste-map-* && rm -rf $TMPDIR/metro-cache && bunx expo prebuild --clean && bunx expo run:ios --device --no-build-cache",
    "test:coverage": "jest --coverage --runInBand",
    "typecheck": "tsc --noEmit",
    "test:watch": "jest --watchAll --coverage=false"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.22",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-pluralrules": "^6.3.16",
    "@lingui/core": "^6.10.1",
    "@lingui/react": "^6.10.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^27.0.0",
    "@react-native-firebase/messaging": "^27.0.0",
    "@scure/base": "^2.4.0",
    "@sentry/react-native": "~8.28.0",
    "expo": "^58.0.17",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-fast-squircle": "^1.1.6",
    "react-native-pulsar": "^1.7.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@lingui/babel-plugin-lingui-macro": "^6.10.1",
    "@lingui/cli": "^6.10.1",
    "@lingui/metro-transformer": "^6.10.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lingui": "^0.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.bun/|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/.*|@scure/.*|@lingui/.*|@messageformat/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "clearMocks": true,
    "restoreMocks": true,
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/services/**/*.ts",
      "src/utils/**/*.ts",
      "src/stores/**/*.ts",
      "src/types/token.ts",
      "src/errors/**/*.ts",
      "src/components/token-detail/token-detail-utils.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      }
    },
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest",
      "^.+\\.mjs$": "babel-jest"
    }
  }
}
