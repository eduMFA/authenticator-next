{
  "name": "edumfa-push",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "postinstall": "bun run licenses:generate",
    "prestart": "bun run licenses:generate",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "i18n:check": "bun run i18n:extract && bun run i18n:compile && git diff --exit-code -- src/locales",
    "licenses:check": "bun run licenses:generate && git diff --exit-code -- src/generated/open-source-licenses.ts",
    "licenses:generate": "bun scripts/generate-open-source-licenses.mjs",
    "test": "jest",
    "lint": "expo lint",
    "clean-ios": "watchman watch-del-all && rm -fr $TMPDIR/haste-map-* && rm -rf $TMPDIR/metro-cache && bunx expo prebuild --clean && bunx expo run:ios --device --no-build-cache",
    "full-clean-ios": "rm -rf node_modules && bun pm cache rm && bun i && watchman watch-del-all && rm -fr $TMPDIR/haste-map-* && rm -rf $TMPDIR/metro-cache && bunx expo prebuild --clean && bunx expo run:ios --device --no-build-cache",
    "test:coverage": "jest --coverage --runInBand",
    "typecheck": "tsc --noEmit",
    "test:watch": "jest --watchAll --coverage=false"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~57.0.22",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@lingui/core": "^6.9.0",
    "@lingui/react": "^6.9.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@scure/base": "^2.4.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "^57.0.27",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fast-squircle": "^1.1.5",
    "react-native-pulsar": "^1.7.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@lingui/babel-plugin-lingui-macro": "^6.9.0",
    "@lingui/cli": "^6.9.0",
    "@lingui/metro-transformer": "^6.9.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lingui": "^0.14.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.bun/|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/.*|@scure/.*|@lingui/.*|@messageformat/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "clearMocks": true,
    "restoreMocks": true,
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/services/**/*.ts",
      "src/utils/**/*.ts",
      "src/stores/**/*.ts",
      "src/types/token.ts",
      "src/errors/**/*.ts",
      "src/components/token-detail/token-detail-utils.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      }
    },
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest",
      "^.+\\.mjs$": "babel-jest"
    }
  }
}
