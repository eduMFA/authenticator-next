+package expo.modules.notifications.notifications.presentation.builders
+
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.os.SystemClock
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.ByteArrayOutputStream
+import java.net.URL
+import javax.net.ssl.HttpsURLConnection
+
+private const val MAX_ICON_BYTES = 512 * 1024
+private const val ICON_TIMEOUT_MS = 1500
+
+internal suspend fun loadTokenNotificationIcon(value: String?): Bitmap? {
+  if (value.isNullOrEmpty()) return null
+  return withContext(Dispatchers.IO) {
+    runCatching {
+      val url = URL(value)
+      if (url.protocol != "https" || url.host.isEmpty() || url.userInfo != null) return@runCatching null
+      val connection = url.openConnection() as HttpsURLConnection
+      val deadline = SystemClock.elapsedRealtime() + ICON_TIMEOUT_MS
+      try {
+        connection.instanceFollowRedirects = false
+        connection.connectTimeout = ICON_TIMEOUT_MS
+        connection.readTimeout = ICON_TIMEOUT_MS
+        if (connection.responseCode != 200 || connection.contentLength > MAX_ICON_BYTES) return@runCatching null
+
+        val output = ByteArrayOutputStream()
+        val buffer = ByteArray(8192)
+        connection.inputStream.use { input ->
+          while (true) {
+            val remaining = deadline - SystemClock.elapsedRealtime()
+            if (remaining <= 0) return@runCatching null
+            connection.readTimeout = remaining.toInt()
+            val read = input.read(buffer)
+            if (read == -1) break
+            if (read > MAX_ICON_BYTES - output.size()) return@runCatching null
+            output.write(buffer, 0, read)
+          }
+        }
+        val bytes = output.toByteArray()
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeByteArray(bytes, 0, bytes.size, bounds)
+        if (bounds.outWidth !in 1..4096 || bounds.outHeight !in 1..4096) return@runCatching null
+        val longestSide = maxOf(bounds.outWidth, bounds.outHeight)
+        val sample = Integer.highestOneBit(maxOf(1, longestSide / 128))
+        BitmapFactory.decodeByteArray(bytes, 0, bytes.size, BitmapFactory.Options().apply {
+          inSampleSize = sample
+        })
+      } finally {
+        connection.disconnect()
+      }
+    }.getOrNull()
+  }
+}
